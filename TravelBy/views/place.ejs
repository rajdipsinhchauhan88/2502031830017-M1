<section id="places">

    <div class="place-card">
        <img src="goa.jpg" alt="Goa">
        <div class="place-info">
            <h2>Goa</h2>
            <p>Beautiful beaches and nightlife.</p>
        </div>
    </div>

    <div class="place-card">
        <img src="manali,jpg.png" alt="Manali">
        <div class="place-info">
            <h2>Manali</h2>
            <p>Snow mountains and adventure sports.</p>
        </div>
    </div>

    <div class="place-card">
        <img src="kasmir.jgp.webp" alt="Kashmir">
        <div class="place-info">
            <h2>Kashmir</h2>
