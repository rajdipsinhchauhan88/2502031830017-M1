        <div class="place-info">
            <h2>Dubai</h2>
            <p>Luxury city and skyscrapers.</p>
        </div>
    </div>

    <div class="place-card">
        <img src="bali.jpg" alt="Bali">
        <div class="place-info">
            <h2>Bali</h2>
            <p>Tropical paradise and beaches.</p>
        </div>
    </div>

    <div class="place-card">
